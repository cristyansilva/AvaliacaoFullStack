# Copie este arquivo para .env e ajuste os valores conforme seu ambiente:
#   cp .env.example .env
#
# O arquivo .env é ignorado pelo Git (ver .gitignore) — nunca versione credenciais reais.

# Porta em que o servidor Express será iniciado (padrão: 3001)
PORT=3001

# Configurações de conexão com o PostgreSQL (usadas em db.js)
# DB_USER, DB_HOST e DB_PORT já estão preenchidos com os padrões locais do PostgreSQL.
# Preencha DB_NAME e DB_PASSWORD de acordo com o banco e a senha configurados na sua máquina:
DB_USER=postgres
DB_HOST=localhost
DB_NAME=nome_do_seu_banco
DB_PASSWORD=sua_senha_aqui
DB_PORT=5432
